<launch>
  <node name="usb_cam_left" pkg="usb_cam_auto_exposure" type="usb_cam_auto_exposure_node" output="screen" >
      <rosparam command="load" file="$(find master_arbeit)/config/hw/usb_cam_left.yaml"/>
  	</node>

	<node name="auto_exposure_control_left" pkg="usb_cam_auto_exposure" type="auto_exposure_node.py" respawn="true" output="screen">
		<param name="camera_name" type="string" value="usb_cam_left"/>
		<remap from="image_raw" to="/usb_cam_left/image_raw"/>
  </node>
</launch>
